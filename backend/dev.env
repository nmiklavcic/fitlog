# Local development settings only. NEVER use these values on a server.
# Production values live in /etc/liftlog/liftlog.env (see docs/deploy/liftlog.env.example).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173
DB_NAME=liftlog
DB_USER=liftlog
DB_PASSWORD=liftlog
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
MEDIA_URL_SIGNING_SECRET=dev-only-media-secret
LOG_FORMAT=text
LOG_LEVEL=INFO
# Leave the Stripe keys empty to use demo billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
