# /etc/liftlog/liftlog.env (reference): loaded by systemd (EnvironmentFile=).
#   install -o root -g liftlog -m 640 liftlog.env /etc/liftlog/liftlog.env
# Generate secrets with:  python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
# Format: KEY=value, no quotes, no spaces around "=", no "export".

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE_ME
# Your hostname, plus 127.0.0.1/localhost so health checks and Prometheus can reach Gunicorn directly.
DJANGO_ALLOWED_HOSTS=liftlog.example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://liftlog.example.com
# Used in password-reset emails and Stripe redirects.
PUBLIC_BASE_URL=https://liftlog.example.com
APP_VERSION=1.0.0
TIME_ZONE=Europe/Ljubljana
# Optional: DJANGO_SECURE_SSL_REDIRECT=1  DJANGO_HSTS_SECONDS=31536000
#           DJANGO_HSTS_INCLUDE_SUBDOMAINS=0  DJANGO_HSTS_PRELOAD=0

# --- PostgreSQL ---------------------------------------------------------------
# Empty DB_HOST = Unix socket + peer authentication: the "liftlog" OS user logs in
# as the "liftlog" database role with no password at all.
DB_NAME=liftlog
DB_USER=liftlog
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis (cache, sessions, rate limits) ---------------------------------------
# With `requirepass` in /etc/redis/redis.conf: redis://:PASSWORD@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# --- Files --------------------------------------------------------------------
MEDIA_ROOT=/var/lib/liftlog/media
STATIC_ROOT=/var/lib/liftlog/static
# Must be identical to the secret in the Nginx secure_link_md5 line.
MEDIA_URL_SIGNING_SECRET=CHANGE_ME
# MEDIA_URL_TTL_SECONDS=21600
# MAX_UPLOAD_BYTES=10485760

# --- Email (password reset). Without EMAIL_HOST, emails are written to the log. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Liftlog <no-reply@liftlog.example.com>

# --- Stripe (test mode). Leave both empty for demo billing. ----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Logging & Gunicorn ---------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_BIND=127.0.0.1:8000
# LOGIN_FAILURE_LIMIT=5
# LOGIN_LOCKOUT_SECONDS=900
